{
  "id": "e2e-sort-products-add-to-cart",
  "testPlanId": "bd1ebf84-ab1f-4291-8ba8-2c62bfb15e73",
  "requirementId": "c1336381-25b3-4947-97f6-5a4c07810412",
  "suiteName": "Product Listing & Add to Cart",
  "case": {
    "id": "e2e-sort-products-add-to-cart",
    "title": "E2E: Sort products and add sorted product to cart",
    "priority": "P2",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "step1",
        "action": "openUrl",
        "targetDescription": "Navigate to login page",
        "locatorHint": "https://www.saucedemo.com/",
        "value": "https://www.saucedemo.com/"
      },
      {
        "id": "step2",
        "action": "fill",
        "targetDescription": "Enter username",
        "locatorHint": "[data-test='username']",
        "value": "standard_user"
      },
      {
        "id": "step3",
        "action": "fill",
        "targetDescription": "Enter password",
        "locatorHint": "[data-test='password']",
        "value": "secret_sauce"
      },
      {
        "id": "step4",
        "action": "tap",
        "targetDescription": "Click login button",
        "locatorHint": "[data-test='login-button']"
      },
      {
        "id": "step5",
        "action": "selectOption",
        "targetDescription": "Sort products by price (low to high)",
        "locatorHint": "[data-test='product_sort_container']",
        "value": "lohi"
      },
      {
        "id": "step6",
        "action": "tap",
        "targetDescription": "Add first product to cart after sorting",
        "locatorHint": ".inventory_item:first-child [data-test^='add-to-cart']"
      },
      {
        "id": "step7",
        "action": "assertText",
        "targetDescription": "Verify cart icon shows 1 item",
        "locatorHint": ".shopping_cart_badge",
        "assertion": "1"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
