{
  "id": "smoke-login-listing-add-cart",
  "testPlanId": "bd1ebf84-ab1f-4291-8ba8-2c62bfb15e73",
  "requirementId": "c1336381-25b3-4947-97f6-5a4c07810412",
  "suiteName": "Product Listing & Add to Cart",
  "case": {
    "id": "smoke-login-listing-add-cart",
    "title": "Login, view product listing, and add product to cart",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "step1",
        "action": "openUrl",
        "targetDescription": "Navigate to login page",
        "locatorHint": "https://www.saucedemo.com/",
        "value": "https://www.saucedemo.com/"
      },
      {
        "id": "step2",
        "action": "fill",
        "targetDescription": "Enter username",
        "locatorHint": "[data-test='username']",
        "value": "standard_user"
      },
      {
        "id": "step3",
        "action": "fill",
        "targetDescription": "Enter password",
        "locatorHint": "[data-test='password']",
        "value": "secret_sauce"
      },
      {
        "id": "step4",
        "action": "tap",
        "targetDescription": "Click login button",
        "locatorHint": "[data-test='login-button']"
      },
      {
        "id": "step5",
        "action": "assertVisible",
        "targetDescription": "Verify inventory page is displayed",
        "locatorHint": ".inventory_list"
      },
      {
        "id": "step6",
        "action": "tap",
        "targetDescription": "Click 'Add to Cart' for Sauce Labs Backpack",
        "locatorHint": "[data-test='add-to-cart-sauce-labs-backpack']"
      },
      {
        "id": "step7",
        "action": "assertText",
        "targetDescription": "Verify cart icon shows 1 item",
        "locatorHint": ".shopping_cart_badge",
        "assertion": "1"
      }
    ],
    "tags": [
      "@smoke",
      "@regression"
    ]
  }
}
