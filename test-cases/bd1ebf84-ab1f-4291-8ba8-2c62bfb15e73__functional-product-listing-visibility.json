  "suiteName": "Product Listing & Add to Cart",
  "case": {
    "id": "functional-product-listing-visibility",
    "title": "Verify all products are visible on product listing page",
    "priority": "P1",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "step1",
        "action": "openUrl",
        "targetDescription": "Navigate to login page",
        "locatorHint": "https://www.saucedemo.com/",
        "value": "https://www.saucedemo.com/"
      },
      {
        "id": "step2",
        "action": "fill",
        "targetDescription": "Enter username",
        "locatorHint": "[data-test='username']",
        "value": "standard_user"
      },
      {
        "id": "step3",
        "action": "fill",
        "targetDescription": "Enter password",
        "locatorHint": "[data-test='password']",
        "value": "secret_sauce"
      },
      {
        "id": "step4",
        "action": "tap",
        "targetDescription": "Click login button",
        "locatorHint": "[data-test='login-button']"
      },
      {
        "id": "step5",
        "action": "assertCountGreaterThan",
        "targetDescription": "Verify at least one product is listed",
        "locatorHint": ".inventory_item"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
